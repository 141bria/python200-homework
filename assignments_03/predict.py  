import joblib
import json
import pandas as pd
import numpy as np 
#Task 7#
clf = joblib.load("models/weather_classifier.pkl")
with open("models/weather_classifier_metadata.json") as f:
    metadata = json.load(f)
print(type(clf))
print(metadata["city"])
print(metadata["features"])
print(metadata["test_accuracy"])
new_days = pd.DataFrame([
  {"temperature_2m_max":15,"temperature_2m_min":5,"precipitation_sum":1,"wind_speed_10m_max":10},
  {"temperature_2m_max":4,"temperature_2m_min":-1,"precipitation_sum":9,"wind_speed_10m_max":40},  
  {"temperature_2m_max":6,"temperature_2m_min":0,"precipitation_sum":3,"wind_speed_10m_max":29},
  {"temperature_2m_max":20,"temperature_2m_min":0,"precipitation_sum":3,"wind_speed_10m_max":45}  
])
new_days = new_days[metadata["features"]]
preds = clf.predict(new_days)
probs = clf.predict_proba(new_days)[:,1]
for d,(preds,probs) in enumerate(zip(preds,probs)):
    label = "good" if preds == 1 else "skip"
    print(new_days.iloc[d])
    print(f"Day {d + 1}: {label} (confidence: {probs:.2f})")
